# ── CKCET Mess — Environment Variables ──────────
# Copy this file as .env and fill in your Firebase project values.
# These VITE_ prefixed keys are safe to expose in the frontend.
# NEVER put secret keys (Razorpay secret, Firebase Admin SDK) here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
